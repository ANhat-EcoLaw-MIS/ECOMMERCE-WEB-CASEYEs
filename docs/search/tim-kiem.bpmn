<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_TimKiem" targetNamespace="https://caseyes.vn/bpmn/tim-kiem">
  <bpmn:collaboration id="Collab_TimKiem">
    <bpmn:participant id="Pool_TimKiem" name="Tìm kiếm và gợi ý ốp" processRef="Proc_TimKiem" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_TimKiem" name="Tìm kiếm và gợi ý ốp" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_KH" name="Khách hàng">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EORD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EDS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EOK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HT" name="Hệ thống CasEYE's (web)">
        <bpmn:flowNodeRef>SA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SN</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Khách mở tìm kiếm (ô tìm, Ctrl K, ✨)">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="Cách tìm?">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TA" name="Gõ từ khóa hoặc dán mã đơn">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB" name="Mô tả chiếc ốp mong muốn">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TC" name="Tải ảnh tham khảo">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="SA" name="Chuẩn hóa tiếng Việt, nhận dòng máy và mã đơn, xếp hạng">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SB" name="Nhận ý muốn (màu, phong cách, chủ đề, dịp) và chấm điểm kèm lý do">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GC" name="Ảnh hợp lệ? (JPG/PNG/WebP, ≤ 5 MB)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EERR" name="Báo lỗi định dạng ảnh">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="SC" name="Lấy màu chủ đạo, xếp mẫu theo độ gần màu">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GA" name="Là mã đơn?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EORD" name="Mở trang theo dõi đơn">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GM" name="Có kết quả?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SR" name="Hiện kết quả theo nhóm, ghi nhật ký từ khóa (không dữ liệu cá nhân)">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SN" name="Đề xuất Gợi ý theo mô tả hoặc Tự thiết kế với ý tưởng này">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="KN" name="Vào Design Studio cùng ý tưởng">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="KR" name="Chọn mẫu, ốp có sẵn hoặc trang hỗ trợ">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EDS" name="Bắt đầu thiết kế">
      <bpmn:incoming>f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EOK" name="Xem chi tiết và mua / dùng mẫu">
      <bpmn:incoming>f20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="G1" />
    <bpmn:sequenceFlow id="f2" name="Từ khóa" sourceRef="G1" targetRef="TA" />
    <bpmn:sequenceFlow id="f3" name="Mô tả" sourceRef="G1" targetRef="TB" />
    <bpmn:sequenceFlow id="f4" name="Ảnh" sourceRef="G1" targetRef="TC" />
    <bpmn:sequenceFlow id="f5" sourceRef="TA" targetRef="SA" />
    <bpmn:sequenceFlow id="f6" sourceRef="TB" targetRef="SB" />
    <bpmn:sequenceFlow id="f7" sourceRef="TC" targetRef="GC" />
    <bpmn:sequenceFlow id="f8" name="Không" sourceRef="GC" targetRef="EERR" />
    <bpmn:sequenceFlow id="f9" name="Có" sourceRef="GC" targetRef="SC" />
    <bpmn:sequenceFlow id="f10" sourceRef="SA" targetRef="GA" />
    <bpmn:sequenceFlow id="f11" name="Có" sourceRef="GA" targetRef="EORD" />
    <bpmn:sequenceFlow id="f12" name="Không" sourceRef="GA" targetRef="GM" />
    <bpmn:sequenceFlow id="f13" sourceRef="SB" targetRef="GM" />
    <bpmn:sequenceFlow id="f14" sourceRef="SC" targetRef="GM" />
    <bpmn:sequenceFlow id="f15" name="Có" sourceRef="GM" targetRef="SR" />
    <bpmn:sequenceFlow id="f16" name="Không" sourceRef="GM" targetRef="SN" />
    <bpmn:sequenceFlow id="f17" sourceRef="SN" targetRef="KN" />
    <bpmn:sequenceFlow id="f18" sourceRef="SR" targetRef="KR" />
    <bpmn:sequenceFlow id="f19" sourceRef="KN" targetRef="EDS" />
    <bpmn:sequenceFlow id="f20" sourceRef="KR" targetRef="EOK" />
  </bpmn:process>
